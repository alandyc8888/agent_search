          "endpoint": "/v1/ocr",
          "price": {
            "mode": "variable",
            "amount": "0.01",
            "max": "0.50",
            "currency": "USD",
            "unit": "job"
          },
          "accepts": [
            "base-usdc"
          ],
          "deliveryWithin": 300,
          "limits": {
            "maxFileMB": 50,
            "maxPages": 50
          },
          "updatedAt": "2026-11-09T00:00:00Z",
          "input": "both",
          "billing": "per_file",
          "chargeOnFailure": false
        },
        {
          "id": "compress",
          "title": "PDF compress",
          "summary": "Lossy or lossless PDF compression",
          "category": "file.compress",
          "endpoint": "/v1/compress",
          "price": {
            "mode": "fixed",
            "amount": "0.005",
            "currency": "USD",
            "unit": "job"
          },
          "accepts": [
            "base-usdc"
          ],
          "deliveryWithin": 60,
          "limits": {
            "maxFileMB": 50
          },
          "updatedAt": "2026-11-09T00:00:00Z",
          "input": "both",
          "billing": "per_file",
          "chargeOnFailure": false
        },
        {
          "id": "bulk",
          "title": "Bulk OCR quote",
          "summary": "Send a description of a large batch; we reply with a signed quote",
          "category": "doc.ocr",
          "price": {
            "mode": "variable",
            "amount": "5",
            "max": "200",
            "currency": "USD",
            "unit": "job"
          },
          "accepts": [
            "base-usdc"
          ],
          "deliveryWithin": 86400,
          "updatedAt": "2026-11-09T00:00:00Z",
          "input": "url",
          "billing": "per_file",
          "chargeOnFailure": false
        }
      ],
      "a2n:paymentMethods": [
        {
          "id": "base-usdc",
          "kind": "x402",
          "version": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "payTo": "0x000000000000000000000000000000000000Df01",
          "maxTimeoutSeconds": 300
        }
      ],
      "a2n:declarations": {
        "operator": {
          "name": "Example Tools (sole trader)",
          "country": "DE"
        },
        "dataPolicy": {
          "retention": "deleted within 1 hour",
          "training": false,
          "region": "EU",
          "url": "https://pdftools.example/privacy"
        }
      },
      "a2n:sameOwnerAs": [
        "urn:air:imgtools.example:media:resize"
      ],
      "trustManifest": {
        "identity": "did:web:pdftools.example",
        "trustSchema": {
          "id": "a2n-listing-jws/v1",
          "governanceUri": "https://net.example/spec/listing-signature",
          "verificationMethods": [
            "did:web"
          ]
        },
        "signature": "<detached-jws>"
      }
    }
